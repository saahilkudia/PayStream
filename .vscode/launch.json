{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run C program in new window",
        "type": "cppdbg",
        "request": "launch",
        "program": "C:\\Windows\\System32\\cmd.exe",  // Full path to cmd.exe
        "args": [
          "/c",  // Use /c to run the command and then close the window automatically
          "${fileDirname}\\${fileBasenameNoExtension}.exe",  // Path to your compiled .exe file
          "&&",  // Combine commands (if one fails, next command doesn't execute)
          "timeout",  // Run timeout command
          "/t", "0",  // Timeout command with 0 seconds
          "&&",  // Ensure program finishes and waits for user input
          "pause"  // Pause to simulate Enter-to-close
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true,  // Open a new console window
        "preLaunchTask": "build C program",  // Build the program before launching
        "MIMode": "gdb",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    ]
  }
  